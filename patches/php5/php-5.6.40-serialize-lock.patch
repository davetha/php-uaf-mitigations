diff --git a/ext/standard/var_unserializer.c b/ext/standard/var_unserializer.c
index f94d1763..1985c06e 100644
--- a/ext/standard/var_unserializer.c
+++ b/ext/standard/var_unserializer.c
@@ -430,8 +430,22 @@ static inline int object_custom(UNSERIALIZE_PARAMETER, zend_class_entry *ce)
 	if (ce->unserialize == NULL) {
 		zend_error(E_WARNING, "Class %s has no unserializer", ce->name);
 		object_init_ex(*rval, ce);
-	} else if (ce->unserialize(rval, ce, (const unsigned char*)*p, datalen, (zend_unserialize_data *)var_hash TSRMLS_CC) != SUCCESS) {
-		return 0;
+	} else {
+		/* Serializable::unserialize() runs user code that may call
+		 * php_var_unserialize() recursively: bump the lock so the nested
+		 * call gets its own var_hash instead of sharing ours (UAF). */
+		int tmp;
+
+		if (ce->type & ZEND_INTERNAL_CLASS) {
+			tmp = ce->unserialize(rval, ce, (const unsigned char*)*p, datalen, (zend_unserialize_data *)var_hash TSRMLS_CC);
+		} else {
+			BG(serialize_lock)++;
+			tmp = ce->unserialize(rval, ce, (const unsigned char*)*p, datalen, (zend_unserialize_data *)var_hash TSRMLS_CC);
+			BG(serialize_lock)--;
+		}
+		if (tmp != SUCCESS) {
+			return 0;
+		}
 	}
 
 	(*p) += datalen;
