#!/usr/bin/env bpftrace
//php-uaf-chain-detect.bt --- live detection of the unserialize var_hash UAF
//exploit chain (Calif MAD Bugs class / CVE-2026-109618 era). Kernel 4.9+,
//root required. Signatures:
#
//PAYOFF: a PHP worker (php/php-fpm/lsphp/httpd/apache2) execve()s a shell
//(zif_system / libc system() reached via forged dispatch).
//Legit apps that shell out also trip this; tune the filter.
//CRASH-ORACLE: user page-fault bursts in php workers = the address-probing
//stage crashing prefork workers repeatedly.
#
//Usage: sudo bpftrace php-uaf-chain-detect.bt
//Alert-only. el7 counterpart: stap/php-uaf-chain-detect.stp (can SIGKILL).

//How php workers are identified: bpftrace predicates do NOT support regex
//and comm globs match nothing at runtime, so this tracks a pid set instead.
//A process that execve()s a path containing "php" (php, php-fpm, php82,
//lsphp, alt-php, cpanel_php_fpm, imunify360-php) is registered; forks
//inherit the registration (fpm/lsphp workers are forked, never exec'd);
//exec of anything else or process exit unregisters. httpd/apache2 (mod_php)
//never exec php and are matched by exact comm instead.

BEGIN
{
    printf("php-uaf-chain-detect active (payoff + crash-oracle)\n");
}

tracepoint:syscalls:sys_enter_execve
{
    $f = str(args.filename);
    if (@isphp[pid] == 1) {
        if ($f == "/bin/sh" || $f == "/bin/bash" || $f == "/bin/dash") {
            printf("[PAYOFF] pid=%d execve(%s)\n", pid, $f);
        }
    }
    if (strcontains($f, "php")) {
        @isphp[pid] = 1;
    } else {
        $d = delete(@isphp[pid]);
    }
}

tracepoint:sched:sched_process_fork
/@isphp[args->parent_pid] == 1/
{
    @isphp[args->child_pid] = 1;
}

tracepoint:sched:sched_process_exit
{
    $d = delete(@isphp[pid]);
}

tracepoint:exceptions:page_fault_user
/@isphp[pid] == 1 || comm == "httpd" || comm == "apache2"/
{
    @faults[pid] = count();
}

tracepoint:signal:signal_generate
/(args.sig == 11 || args.sig == 6) && (@isphp[args->pid] == 1 || comm == "httpd" || comm == "apache2")/
{
    @deaths[args.sig]++;
}

interval:s:10
{
    print("=== user page faults per php worker pid (crash-oracle signal) ===");
    print(@faults);
    clear(@faults);
    // worker-death oracle: SIGSEGV/SIGABRT deaths in the window (SIGABRT =
    // zend_mm_heap corrupted / glibc allocator aborts; SIGSEGV = fiber/zip
    // class). Global count, not per-pid: prefork churn defeats per-pid rates.
    $d = (@deaths[11] + @deaths[6]);
    if ($d >= 3) {
        printf("[CRASH-ORACLE] %d php worker deaths in 10s (SIGSEGV=%d SIGABRT=%d)\n", $d, @deaths[11], @deaths[6]);
    }
    clear(@deaths);
}
